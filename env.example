# Enhanced QnA Agent System - MVP Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qna_agent
DB_USER=postgres
DB_PASSWORD=password

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
